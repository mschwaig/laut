Subject: [PATCH] Restore sorted rewrite positions for HashModuloSink

Base: 40ab933003b7f0bc9fd9270fd95aca2d2dc34c24
Backports the focused production changes from:
  f546f4b8356ccceb21e2aff355daae1b7a7b3ee7
    HashModuloSink: Hash the positions of self-references again
  7523932a1d23c35395cf241703f30b7e19604add
    RewritingSink: Use std::set for matches and add a chunking test

Collect absolute match offsets in the existing rewrite implementation and
keep them sorted and unique before HashModuloSink hashes their suffix.
Use deterministic regressions for hash preimages, original byte counts,
partially zeroed self-references, and noninteracting streaming rewrites.

diff --git a/src/libstore/include/nix/store/references.hh b/src/libstore/include/nix/store/references.hh
--- a/src/libstore/include/nix/store/references.hh
+++ b/src/libstore/include/nix/store/references.hh
@@ -3,6 +3,8 @@
 
 #include "nix/util/hash.hh"
 
+#include <set>
+
 namespace nix {
 
 class RefScanSink : public Sink
@@ -41,7 +43,7 @@ public:
     Sink & nextSink;
     uint64_t pos = 0;
 
-    std::vector<uint64_t> matches;
+    std::set<uint64_t> matches;
 
     RewritingSink(const std::string & from, const std::string & to, Sink & nextSink);
     RewritingSink(const StringMap & rewrites, Sink & nextSink);
diff --git a/src/libstore/references.cc b/src/libstore/references.cc
--- a/src/libstore/references.cc
+++ b/src/libstore/references.cc
@@ -78,7 +78,7 @@ void RewritingSink::operator()(std::string_view data)
     std::string s(prev);
     s.append(data);
 
-    s = rewriteStrings(s, rewrites);
+    s = rewriteStrings(s, rewrites, &matches, pos);
 
     prev = s.size() < maxRewriteSize ? s
            : maxRewriteSize == 0     ? ""
@@ -103,6 +103,7 @@ void RewritingSink::flush()
 
 HashModuloSink::HashModuloSink(HashAlgorithm ha, const std::string & modulus)
     : hashSink(ha)
+    // Zero out self-references (the "modulus").
     , rewritingSink(modulus, std::string(modulus.size(), 0), hashSink)
 {
 }
diff --git a/src/libutil/include/nix/util/util.hh b/src/libutil/include/nix/util/util.hh
--- a/src/libutil/include/nix/util/util.hh
