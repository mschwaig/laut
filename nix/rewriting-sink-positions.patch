+TEST(references, rewritingSinkPositionsAndChunking)
+{
+    // Keys and replacements do not interact; map order differs from stream order.
+    const StringMap rewrites{{"aa", "AA"}, {"zzzz", "ZZZZ"}};
+    const std::string input = "zzzz-aa-zzzz-aa";
+    const std::string expected = "ZZZZ-AA-ZZZZ-AA";
+    const std::set<uint64_t> positions{0, 5, 8, 13};
+    const std::string_view data(input);
+
+    auto check = [&](RewritingSink & sink, const StringSink & output) {
+        // All complete matches, including those in the retained tail, are recorded before flush.
+        EXPECT_EQ(sink.matches, positions);
+        EXPECT_EQ(sink.pos + sink.prev.size(), input.size());
+        for (int flushCount = 0; flushCount < 2; ++flushCount) {
+            sink.flush();
+            EXPECT_EQ(output.s, expected);
+            EXPECT_EQ(sink.matches, positions);
+            EXPECT_EQ(sink.pos, input.size());
+            EXPECT_TRUE(sink.prev.empty());
+        }
+    };
+
+    // Includes a single nonempty call and empty leading/trailing chunks.
+    for (size_t split = 0; split <= input.size(); ++split) {
+        SCOPED_TRACE(split);
+        StringSink output;
+        RewritingSink sink(rewrites, output);
+        sink(data.substr(0, split));
+        sink(data.substr(split));
+        check(sink, output);
+    }
+
+    // Includes byte-at-a-time input and a single whole-buffer call.
+    for (size_t chunkSize = 1; chunkSize <= input.size(); ++chunkSize) {
+        SCOPED_TRACE(chunkSize);
+        StringSink output;
+        RewritingSink sink(rewrites, output);
+        for (size_t offset = 0; offset < input.size(); offset += chunkSize)
+            sink(data.substr(offset, chunkSize));
+        check(sink, output);
+    }
+}
+
+TEST(references, hashModuloPositionsAndByteCount)
+{
+    const std::string input = "xabc--abc";
+    const std::string partiallyZeroed = std::string("x") + std::string(3, '\0') + "--abc";
+    const std::string normalized = std::string("x") + std::string(3, '\0') + "--" + std::string(3, '\0');
+    const auto expected = hashString(HashAlgorithm::SHA256, normalized + "|1|6");
+    const auto expectedPartiallyZeroed = hashString(HashAlgorithm::SHA256, normalized + "|6");
+
+    for (size_t chunkSize = 1; chunkSize <= input.size(); ++chunkSize) {
+        SCOPED_TRACE(chunkSize);
+        HashModuloSink sink(HashAlgorithm::SHA256, "abc");
+        HashModuloSink zeroedSink(HashAlgorithm::SHA256, "abc");
+        for (size_t offset = 0; offset < input.size(); offset += chunkSize) {
+            sink(std::string_view(input).substr(offset, chunkSize));
+            zeroedSink(std::string_view(partiallyZeroed).substr(offset, chunkSize));
+        }
+
+        const auto result = sink.finish();
+        const auto zeroedResult = zeroedSink.finish();
+        EXPECT_EQ(result.hash, expected);
+        EXPECT_EQ(zeroedResult.hash, expectedPartiallyZeroed);
+        EXPECT_NE(result.hash, zeroedResult.hash);
+        // Position suffixes affect the hash, not the reported original stream length.
+        EXPECT_EQ(result.numBytesDigested, input.size());
+        EXPECT_EQ(zeroedResult.numBytesDigested, partiallyZeroed.size());
+        EXPECT_EQ(sink.rewritingSink.matches, (std::set<uint64_t>{1, 6}));
+        EXPECT_EQ(zeroedSink.rewritingSink.matches, (std::set<uint64_t>{6}));
+    }
+}
+
